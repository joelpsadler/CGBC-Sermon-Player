{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cedargrovebaptist.church/schemas/CGBC_CONCEPT_REGISTRY_SCHEMA_v1.json",
  "title": "CGBC Concept Registry Schema v1",
  "type": "object",
  "required": ["registryType", "registryVersion", "generatedAt", "sourceBaseCommit", "description", "governance", "concepts"],
  "properties": {
    "registryType": {"const": "CGBC_CONCEPT_REGISTRY"},
    "registryVersion": {"const": "1.0"},
    "generatedAt": {"type": "string", "minLength": 1},
    "sourceBaseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "description": {"type": "string", "minLength": 1},
    "governance": {
      "type": "object",
      "required": ["principle", "candidatePolicy", "scopeNote"],
      "properties": {
        "principle": {"type": "string", "minLength": 1},
        "candidatePolicy": {"type": "string", "minLength": 1},
        "scopeNote": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["conceptId", "label", "aliases", "relatedConceptIds"],
        "properties": {
          "conceptId": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
          "label": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "relatedConceptIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
