{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cgbc-info-map-schema-v1",
  "title": "CGBC Sermon Knowledge Record",
  "type": "object",
  "required": [
    "schemaVersion",
    "sermon",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sermon": {
      "type": "object",
      "required": [
        "stableId",
        "title",
        "date"
      ],
      "properties": {
        "stableId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "speaker": {
          "type": "string"
        },
        "series": {
          "type": "string"
        },
        "study": {
          "type": "string"
        },
        "seriesType": {
          "type": "string"
        },
        "scripture": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bookTags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "videoUrl": {
          "type": "string"
        },
        "episodeUrl": {
          "type": "string"
        },
        "transcriptPath": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "pathOrName": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "argument",
              "question",
              "answer",
              "illustration",
              "application",
              "definition",
              "scriptureTrail",
              "doctrine",
              "wordStudy",
              "quote",
              "transition",
              "observation",
              "connection",
              "outlinePoint"
            ]
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "spokenExact": {
            "type": "string"
          },
          "displayText": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "segmentIndexes": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "scripture": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "doctrine": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "audiences": {
            "type": "array",
            "items": {
              "enum": [
                "discover",
                "deepDive",
                "author",
                "quoteEngine",
                "search"
              ]
            }
          },
          "quoteCandidate": {
            "type": "boolean"
          },
          "publicQuoteStatus": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "approved",
              "featured",
              null
            ]
          },
          "provenance": {
            "type": "string",
            "enum": [
              "PASTOR — SPOKEN EXACT",
              "PASTOR — PREPARED",
              "PASTOR — VISUAL",
              "SCRIPTURE",
              "PASTOR RESOURCE / EXTERNAL SUPPORT",
              "ANALYSIS — SYNTHESIS",
              "ANALYSIS — CLASSIFICATION",
              "ANALYSIS — GENERATED QUESTION",
              "EDITORIAL FLAG"
            ]
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
